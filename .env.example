# Master Secret Key for AES-256-GCM (32 bytes = 64 hex characters)
LICENSE_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_FRAME_TOPIC=camera.frames
KAFKA_EVENT_TOPIC=camera.events
KAFKA_ALERT_TOPIC=camera.alerts

# Media Server
USE_TEST_STREAM=true

# Host MAC override (optional for testing in containers)
# SYSTEM_MAC_OVERRIDE=d0:39:57:53:83:1b
